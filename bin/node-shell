#!/usr/bin/env bash
set -Eeuo pipefail
DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$DIR/common.sh"

# Open an interactive shell inside the Node container in the current project
# Corepack is enabled so yarn/pnpm are available per packageManager

ensure_docker
img="$(resolve_image)"

prepare_project_mounts
append_op_run_env
prepare_tool_mounts
declare -a args=(run --rm -it
    "${__SHIM_PROJECT_MOUNTS[@]}"
    ${__SHIM_OP_ENV[@]+"${__SHIM_OP_ENV[@]}"}
    "${__SHIM_TOOL_MOUNTS[@]}"
)

# Map the dev ports so dev servers started from the shell are reachable.
# The shell takes no command, so ports are always mapped (unlike docker_exec,
# which only maps them for dev-server commands). docker run fails if a host
# port is taken (e.g. a second node-shell), so NODE_SHELL_NO_PORTS=1 opts out.
if [[ "${NODE_SHELL_NO_PORTS:-}" != 1 ]]; then
    IFS=',' read -ra ports <<< "${DOCKER_NODE_PORTS:-$NODE_SHIMS_DEFAULT_PORTS}"
    for p in "${ports[@]}"; do args+=(-p "$p:$p"); done
fi

exec docker "${args[@]}" "$img" sh -lc "$(corepack_setup_script); exec sh"
